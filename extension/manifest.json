{
  "manifest_version": 3,
  "name": "Mizan",
  "version": "0.1.0",
  "description": "Detects bias in Gemini's responses by comparing answers across identity-swapped prompts.",
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["http://localhost:3000/*"],
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["panel.js", "content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.css"],
      "matches": ["https://gemini.google.com/*"]
    }
  ]
}
